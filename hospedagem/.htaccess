# =====================================================================
# .htaccess — Balanças.com (HostGator / cPanel)
# Vai na raiz do site: public_html/.htaccess
# Tudo está dentro de <IfModule>: se um módulo não existir, não dá erro 500.
# =====================================================================
DirectoryIndex index.html index.php
Options -Indexes
ErrorDocument 404 /404.html
AddDefaultCharset UTF-8
AddType image/webp .webp
AddType image/avif .avif
AddType application/manifest+json .webmanifest

# --- Painel de produtos (/painel/): as partes internas nunca abrem --------
# A pasta painel/ tem o próprio .htaccess; estas regras são uma segunda
# trava (continuam valendo se aquele arquivo se perder no envio).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^painel/(lib|privado)(/|$) - [F,L]
  RewriteRule ^painel/(config\.php|LEIA-ME\.md|\.user\.ini|\.htaccess)$ - [F,L,NC]
</IfModule>
<FilesMatch "^(config\.php|primeiro-acesso\.php)$">
  Require all denied
</FilesMatch>

# --- HTTPS + endereço único (sem www) em um só redirecionamento ----------
# O HTTPS de balancass.com já funciona (conferido em 11/10/2026). Se um dia o cadeado
# sumir (SSL vencido/AutoSSL com erro), comente as 4 linhas Rewrite abaixo até resolver.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://balancass.com%{REQUEST_URI} [L,R=301]

  # Endereços do site antigo (já indexados no Google) → páginas novas, com 301
  RewriteRule ^vendas-balancas\.html$ /produtos.html?cat=balancas [R=301,L]
  RewriteRule ^vendas-automacao\.html$ /produtos.html?cat=automacao [R=301,L]
  RewriteRule ^vendas-informatica\.html$ /produtos.html?cat=informatica [R=301,L]
  RewriteRule ^quem-somos\.html$ /empresa.html [R=301,L]
  RewriteRule ^services\.html$ /assistencia.html [R=301,L]
  RewriteRule ^sistemas/sistemas\.html$ /sistema.html [R=301,L]
  RewriteRule ^sistemas/?$ /sistema.html [R=301,L]
</IfModule>

# --- Compressão -----------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/ld+json application/xml image/svg+xml application/manifest+json
</IfModule>

# --- Cache do navegador ---------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/avif "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# --- Segurança e catálogo sempre atualizado -------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # HTML e dados (produtos/clientes/empresa) nunca ficam presos no cache:
  # o que você editar (no painel ou à mão) aparece na hora.
  <FilesMatch "(\.html|produtos\.js|clientes\.js|empresa\.js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Bloqueia arquivos que não devem ser baixados --------------------------
# Em qualquer pasta: configurações, registros de erro e anotações.
<FilesMatch "(^\.ht|^error_log$|\.(log|md|ini|sh)$)">
  Require all denied
</FilesMatch>
# Só na RAIZ do site: backups (.zip, .bak, .sql). Subpastas como /sistemas/
# continuam podendo oferecer arquivos .zip para download.
<IfModule mod_rewrite.c>
  RewriteRule ^[^/]+\.(zip|bak|sql)$ - [F,L,NC]
</IfModule>
