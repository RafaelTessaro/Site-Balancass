# Gerado pelo painel. Esta pasta só guarda fotos: nenhum script pode rodar aqui.
<FilesMatch "(?i)\.(php\d?|phtml|phar|cgi|pl|py|sh)(\.|$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
