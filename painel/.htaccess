# =====================================================================
# Painel Balanças.com — configuração do Apache para public_html/painel/
# Tudo o que depende de módulo está dentro de <IfModule> (sem erro 500).
# =====================================================================
DirectoryIndex index.php
Options -Indexes

# Arquivos que nunca podem ser abertos pelo navegador: configuração, guias (.md),
# .user.ini e os próprios .htaccess (o .htaccess da raiz do site também nega tudo isso)
<FilesMatch "(?i)(^config\.php$|^\.user\.ini$|^\.ht|\.md$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# O painel nunca pode ser aberto dentro de outro site nem aparecer no Google
# (o index.php também manda esses cabeçalhos; aqui vale para CSS/JS/imagens)
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

# Limite de envio das fotos quando o PHP roda como módulo do Apache.
# (Com PHP-FPM/CGI, que é o comum na HostGator, quem vale é o arquivo .user.ini desta pasta.)
<IfModule mod_php.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 12M
</IfModule>
<IfModule mod_php7.c>
  php_value upload_max_filesize 10M
  php_value post_max_size 12M
</IfModule>
